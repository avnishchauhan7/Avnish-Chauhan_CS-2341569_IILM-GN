class Solution {
    public int cutRod(int[] price) {
        // code here
        int n = price.length;
        int[] dp = new int[n + 1];
        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= i; j++) {
            dp[i] = Math.max(dp[i], dp[i-j] +price[j - 1]);
            }
           
        }
        return dp[n];
    }
}
